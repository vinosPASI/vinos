# SmartWinery Backend - Environment Variables

# Server
PORT=8080
NODE_ENV=production
CORS_ORIGIN=*

# PocketBase
POCKETBASE_URL=http://pocketbase:8090
POCKETBASE_ADMIN_EMAIL=admin@smartwinery.com
POCKETBASE_ADMIN_PASSWORD=

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=admin_winery
MINIO_SECRET_KEY=SmartPassword123!
MINIO_USE_SSL=false

# ML / Ollama
ML_MODELS_URL=http://host.docker.internal:11434
VISION_LLM_MODEL=qwen2.5vl:3b

# Cloudflare Tunnel
CLOUDFLARE_TUNNEL_TOKEN=
